{
  "version": 2,
  "builds": [
    {
      "src": "app.py",
      "use": "@vercel/python"
    }
  ],
  "routes": [
    {
      "src": "/api/track-click",
      "dest": "app.py",
      "methods": ["GET", "POST", "OPTIONS"]
    },
    {
      "src": "/api/stats",
      "dest": "app.py",
      "methods": ["GET", "OPTIONS"]
    },
    {
      "src": "/(.*)",
      "dest": "app.py"
    }
  ]
}
